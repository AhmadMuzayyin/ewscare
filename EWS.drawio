<mxfile host="app.diagrams.net">
  <diagram name="Page-1" id="2UWY1QAiPbFhEdXmSyRt">
    <mxGraphModel dx="4040" dy="2123" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml EWSCare_System\n!theme cerulean-outline\nskinparam backgroundColor #FEFEFE\nskinparam activityBorderColor #2563EB\nskinparam activityBackgroundColor #EFF6FF\nskinparam activityDiamondBackgroundColor #FEF3C7\nskinparam activityDiamondBorderColor #D97706\nskinparam activityBarColor #2563EB\nskinparam shadowing false\nskinparam defaultFontName Inter\nskinparam titleFontSize 20\nskinparam titleFontColor #1E3A5F\n\ntitle Flowchart Sistem EWSCare\n\n|#EFF6FF|Pengguna (Admin Kesehatan)|\nstart\n\n:Akses Aplikasi EWSCare;\n\n|#FFF7ED|Autentikasi|\n:Halaman Login;\n\nif (Sudah punya akun?) then (Ya)\n  :Masukkan Email &amp; Password;\n  if (Kredensial valid?) then (Ya)\n    if (2FA aktif?) then (Ya)\n      :Masukkan kode TOTP / Recovery Code;\n      if (Kode valid?) then (Ya)\n      else (Tidak)\n        :Tampilkan error;\n        stop\n      endif\n    else (Tidak)\n    endif\n  else (Tidak)\n    :Tampilkan error login;\n    stop\n  endif\nelse (Tidak)\n  :Halaman Register;\n  :Input Nama, Email, Password;\n  :Buat Akun Baru;\nendif\n\n|#ECFDF5|Dashboard EWS|\n:Login Berhasil — Redirect ke Dashboard;\n\nfork\n  :📊 Lihat Statistik Ringkasan\\n(Total Santri, Total Kamar,\\nKasus Baru 7 Hari, Alert Aktif);\nfork again\n  :🗺️ Peta Klaster Spasial\\n(Visualisasi Kamar\\nper Wilayah &amp; Blok);\nfork again\n  :🚨 Peringatan Dini Wabah\\n(EWS Alert Aktif);\nend fork\n\n|#EFF6FF|Pengguna (Admin Kesehatan)|\n:Pilih Menu di Sidebar;\n\nswitch (Menu yang dipilih?)\ncase (Master Data)\n  :Kelola Kamar / Santri /\\nGejala / Penyakit;\n  note right\n    CRUD: Create, Read, \n    Update, Delete\n    untuk setiap entitas\n  end note\ncase (Dataset Training)\n  :Kelola Dataset Training\\n(Kombinasi Gejala-Penyakit);\ncase (Prediksi)\n  :Pengujian Model Naive Bayes\\nterhadap seluruh dataset;\ncase (Laporan)\n  :Riwayat Kesehatan Santri\\n(Historis &amp; Filter);\ncase (Settings)\n  :Profil, Tampilan, Keamanan\\n(2FA / Passkey);\nendswitch\n\nstop\n\n@enduml\n&quot;,&quot;format&quot;:&quot;svg&quot;}" id="VKilzpo9VaYxWsKuG0Ae-1">
          <mxCell parent="1" style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1">
            <mxGeometry height="1259" width="2509" x="20" y="20" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml EWSCare_ERD\n\n&#39; ============================================================\n&#39;  ERD — EWSCare (Early Warning System Care)\n&#39;  Pondok Pesantren Annuqayah Lubangsa\n&#39; ============================================================\n\nskinparam backgroundColor #FAFAFA\nskinparam shadowing false\nskinparam defaultFontName \&quot;Segoe UI, Inter, Arial\&quot;\nskinparam defaultFontSize 12\n\nskinparam entity {\n  BackgroundColor #FFFFFF\n  BorderColor #334155\n  FontColor #1E293B\n  ArrowColor #475569\n  StereotypeFontColor #6366F1\n}\n\nskinparam linetype ortho\nskinparam titleFontSize 22\nskinparam titleFontColor #0F172A\nskinparam titleFontStyle bold\n\ntitle ERD — Aplikasi EWSCare\\n(Early Warning System Kesehatan Santri)\n\n&#39; =====================\n&#39;  TABEL AUTENTIKASI\n&#39; =====================\n\nentity \&quot;users\&quot; as users &lt;&lt;Autentikasi&gt;&gt; #EEF2FF {\n  * **id** : bigint &lt;&lt;PK, AI&gt;&gt;\n  --\n  name : varchar(255)\n  email : varchar(255) &lt;&lt;UNIQUE&gt;&gt;\n  email_verified_at : timestamp &lt;&lt;NULLABLE&gt;&gt;\n  password : varchar(255)\n  two_factor_secret : text &lt;&lt;NULLABLE&gt;&gt;\n  two_factor_recovery_codes : text &lt;&lt;NULLABLE&gt;&gt;\n  two_factor_confirmed_at : timestamp &lt;&lt;NULLABLE&gt;&gt;\n  remember_token : varchar(100) &lt;&lt;NULLABLE&gt;&gt;\n  created_at : timestamp\n  updated_at : timestamp\n}\n\nentity \&quot;passkeys\&quot; as passkeys &lt;&lt;Autentikasi&gt;&gt; #EEF2FF {\n  * **id** : bigint &lt;&lt;PK, AI&gt;&gt;\n  --\n  * user_id : bigint &lt;&lt;FK&gt;&gt;\n  credential_id : varchar\n  public_key : text\n  created_at : timestamp\n  updated_at : timestamp\n}\n\nentity \&quot;sessions\&quot; as sessions &lt;&lt;Sistem&gt;&gt; #F1F5F9 {\n  * **id** : varchar &lt;&lt;PK&gt;&gt;\n  --\n  user_id : bigint &lt;&lt;FK, NULLABLE&gt;&gt;\n  ip_address : varchar(45) &lt;&lt;NULLABLE&gt;&gt;\n  user_agent : text &lt;&lt;NULLABLE&gt;&gt;\n  payload : longtext\n  last_activity : int &lt;&lt;INDEX&gt;&gt;\n}\n\nentity \&quot;cache\&quot; as cache &lt;&lt;Sistem&gt;&gt; #F1F5F9 {\n  * **key** : varchar &lt;&lt;PK&gt;&gt;\n  --\n  value : mediumtext\n  expiration : int\n}\n\nentity \&quot;jobs\&quot; as jobs &lt;&lt;Sistem&gt;&gt; #F1F5F9 {\n  * **id** : bigint &lt;&lt;PK, AI&gt;&gt;\n  --\n  queue : varchar &lt;&lt;INDEX&gt;&gt;\n  payload : longtext\n  attempts : tinyint\n  reserved_at : int &lt;&lt;NULLABLE&gt;&gt;\n  available_at : int\n  created_at : int\n}\n\n&#39; =====================\n&#39;  TABEL MASTER DATA\n&#39; =====================\n\nentity \&quot;kamars\&quot; as kamars &lt;&lt;Master&gt;&gt; #ECFDF5 {\n  * **id** : bigint &lt;&lt;PK, AI&gt;&gt;\n  --\n  wilayah : varchar(255)\n  blok : varchar(255)\n  nama_kamar : varchar(255)\n  kapasitas : int [default: 0]\n  created_at : timestamp\n  updated_at : timestamp\n}\n\nentity \&quot;santris\&quot; as santris &lt;&lt;Master&gt;&gt; #ECFDF5 {\n  * **id** : bigint &lt;&lt;PK, AI&gt;&gt;\n  --\n  * kamar_id : bigint &lt;&lt;FK&gt;&gt;\n  nis : varchar(50) &lt;&lt;UNIQUE&gt;&gt;\n  nama : varchar(255)\n  gender : enum(&#39;L&#39;, &#39;P&#39;)\n  created_at : timestamp\n  updated_at : timestamp\n}\n\nentity \&quot;gejalas\&quot; as gejalas &lt;&lt;Master&gt;&gt; #FEF9C3 {\n  * **id** : bigint &lt;&lt;PK, AI&gt;&gt;\n  --\n  kode_gejala : varchar(50) &lt;&lt;UNIQUE&gt;&gt;\n  nama_gejala : varchar(255)\n  created_at : timestamp\n  updated_at : timestamp\n}\n\nentity \&quot;penyakits\&quot; as penyakits &lt;&lt;Master&gt;&gt; #FEE2E2 {\n  * **id** : bigint &lt;&lt;PK, AI&gt;&gt;\n  --\n  kode_penyakit : varchar(50) &lt;&lt;UNIQUE&gt;&gt;\n  nama_penyakit : varchar(255)\n  is_menular : boolean [default: false]\n  solusi_pencegahan : text &lt;&lt;NULLABLE&gt;&gt;\n  created_at : timestamp\n  updated_at : timestamp\n}\n\n&#39; =====================\n&#39;  TABEL DATASET / AI\n&#39; =====================\n\nentity \&quot;dataset_trainings\&quot; as dataset_trainings &lt;&lt;Naive Bayes&gt;&gt; #FFF7ED {\n  * **id** : bigint &lt;&lt;PK, AI&gt;&gt;\n  --\n  * penyakit_id : bigint &lt;&lt;FK&gt;&gt;\n  created_at : timestamp\n  updated_at : timestamp\n}\n\nentity \&quot;dataset_training_gejala\&quot; as dt_gejala &lt;&lt;Pivot&gt;&gt; #FFF7ED {\n  * **id** : bigint &lt;&lt;PK, AI&gt;&gt;\n  --\n  * dataset_training_id : bigint &lt;&lt;FK&gt;&gt;\n  * gejala_id : bigint &lt;&lt;FK&gt;&gt;\n  created_at : timestamp\n  updated_at : timestamp\n  ..\n  &lt;&lt;UNIQUE&gt;&gt; (dataset_training_id, gejala_id)\n}\n\n&#39; =====================\n&#39;  TABEL TRANSAKSI\n&#39; =====================\n\nentity \&quot;riwayat_kesehatans\&quot; as riwayat &lt;&lt;Transaksi&gt;&gt; #F3E8FF {\n  * **id** : bigint &lt;&lt;PK, AI&gt;&gt;\n  --\n  * santri_id : bigint &lt;&lt;FK&gt;&gt;\n  * penyakit_id : bigint &lt;&lt;FK&gt;&gt;\n  * kamar_id : bigint &lt;&lt;FK&gt;&gt;\n  tanggal_periksa : date &lt;&lt;INDEX&gt;&gt;\n  probabilitas : double\n  tingkat_keyakinan : double\n  created_at : timestamp\n  updated_at : timestamp\n}\n\nentity \&quot;gejala_riwayat_kesehatan\&quot; as grk &lt;&lt;Pivot&gt;&gt; #F3E8FF {\n  * **id** : bigint &lt;&lt;PK, AI&gt;&gt;\n  --\n  * riwayat_kesehatan_id : bigint &lt;&lt;FK&gt;&gt;\n  * gejala_id : bigint &lt;&lt;FK&gt;&gt;\n  created_at : timestamp\n  updated_at : timestamp\n  ..\n  &lt;&lt;UNIQUE&gt;&gt; (riwayat_kesehatan_id, gejala_id)\n}\n\nentity \&quot;ews_alerts\&quot; as ews_alerts &lt;&lt;EWS&gt;&gt; #FEE2E2 {\n  * **id** : bigint &lt;&lt;PK, AI&gt;&gt;\n  --\n  kamar_id : bigint &lt;&lt;FK, NULLABLE&gt;&gt;\n  wilayah : varchar(255) &lt;&lt;NULLABLE&gt;&gt;\n  blok : varchar(255) &lt;&lt;NULLABLE&gt;&gt;\n  * penyakit_id : bigint &lt;&lt;FK&gt;&gt;\n  jumlah_kasus : int\n  status : enum(&#39;Aktif&#39;, &#39;Tertangani&#39;) [default: &#39;Aktif&#39;]\n  tanggal_dideteksi : date &lt;&lt;INDEX&gt;&gt;\n  created_at : timestamp\n  updated_at : timestamp\n}\n\n&#39; ============================================================\n&#39;  RELASI\n&#39; ============================================================\n\n&#39; -- Autentikasi --\nusers ||--o{ passkeys : \&quot;memiliki\&quot;\n\n&#39; -- Kamar &amp; Santri --\nkamars ||--o{ santris : \&quot;menampung\&quot;\n\n&#39; -- Dataset Training --\npenyakits ||--o{ dataset_trainings : \&quot;menjadi target\&quot;\ndataset_trainings ||--o{ dt_gejala : \&quot;memiliki gejala\&quot;\ngejalas ||--o{ dt_gejala : \&quot;digunakan di\&quot;\n\n&#39; -- Riwayat Kesehatan --\nsantris ||--o{ riwayat : \&quot;memiliki riwayat\&quot;\npenyakits ||--o{ riwayat : \&quot;didiagnosa\&quot;\nkamars ||--o{ riwayat : \&quot;lokasi periksa\&quot;\nriwayat ||--o{ grk : \&quot;memiliki gejala\&quot;\ngejalas ||--o{ grk : \&quot;tercatat di\&quot;\n\n&#39; -- EWS Alerts --\nkamars ||--o{ ews_alerts : \&quot;terjadi di\&quot;\npenyakits ||--o{ ews_alerts : \&quot;memicu alert\&quot;\n\n&#39; ============================================================\n&#39;  LEGEND\n&#39; ============================================================\n\nlegend bottom right\n  | **Warna** | **Kategori** |\n  |&lt;#EEF2FF&gt;  | Autentikasi (users, passkeys) |\n  |&lt;#ECFDF5&gt;  | Master Data (kamars, santris) |\n  |&lt;#FEF9C3&gt;  | Master Gejala |\n  |&lt;#FEE2E2&gt;  | Master Penyakit &amp; EWS Alerts |\n  |&lt;#FFF7ED&gt;  | Dataset Training (Naive Bayes) |\n  |&lt;#F3E8FF&gt;  | Transaksi (Riwayat Kesehatan) |\n  |&lt;#F1F5F9&gt;  | Sistem (sessions, cache, jobs) |\n  --\n  **PK** = Primary Key\n  **FK** = Foreign Key\n  **AI** = Auto Increment\n  * = NOT NULL\nendlegend\n\n@enduml\n&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="VKilzpo9VaYxWsKuG0Ae-381">
          <mxCell parent="1" style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1">
            <mxGeometry height="1153" width="1673" x="40" y="1370" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml EWSCare_DFD_Level_0\n\n&#39; ============================================================\n&#39;  DFD Level 0 — Context Diagram\n&#39;  EWSCare (Early Warning System Kesehatan Santri)\n&#39; ============================================================\n\nskinparam backgroundColor #FAFAFA\nskinparam shadowing false\nskinparam defaultFontName \&quot;Segoe UI, Inter, Arial\&quot;\nskinparam defaultFontSize 12\nskinparam titleFontSize 22\nskinparam titleFontColor #0F172A\nskinparam titleFontStyle bold\nskinparam ArrowColor #475569\nskinparam RectangleBorderColor #334155\n\ntitle DFD Level 0 — Context Diagram\\nAplikasi EWSCare\n\n&#39; --- External Entity ---\nrectangle \&quot;**Admin Kesehatan**\\n(Pengguna Sistem)\&quot; as admin #EEF2FF\n\n&#39; --- System ---\nusecase \&quot;**Sistem EWSCare**\\n\\nEarly Warning System\\nKesehatan Santri\\nBerbasis Naive Bayes\\n&amp; Pemetaan Spasial\&quot; as sistem #DBEAFE\n\n&#39; --- Data Flows ---\nadmin -right-&gt; sistem : Data Login / Register\\nData Kamar\\nData Santri\\nData Gejala\\nData Penyakit\\nData Dataset Training\\nGejala Pemeriksaan Santri\\nFilter Laporan\n\nsistem -left-&gt; admin : Konfirmasi Login\\nDashboard &amp; Statistik\\nPeta Spasial Kesehatan\\nHasil Prediksi Naive Bayes\\nAkurasi Model\\nPeringatan Dini Wabah (EWS Alert)\\nLaporan Riwayat Kesehatan\n\n@enduml\n&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="VKilzpo9VaYxWsKuG0Ae-382">
          <mxCell parent="1" style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1">
            <mxGeometry height="288" width="530" x="2950" y="262" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml EWSCare_DFD_Level_1\n\n&#39; ============================================================\n&#39;  DFD Level 1 — Diagram Rinci (Portrait / Vertikal)\n&#39;  EWSCare (Early Warning System Kesehatan Santri)\n&#39; ============================================================\n\ntop to bottom direction\nscale 1\n\nskinparam backgroundColor #FAFAFA\nskinparam shadowing false\nskinparam defaultFontName \&quot;Segoe UI, Inter, Arial\&quot;\nskinparam defaultFontSize 12\nskinparam titleFontSize 20\nskinparam titleFontColor #0F172A\nskinparam titleFontStyle bold\nskinparam ArrowColor #475569\nskinparam RectangleBorderColor #334155\n\ntitle DFD Level 1 — Aplikasi EWSCare\n\n&#39; ============================================================\n&#39;  EXTERNAL ENTITY\n&#39; ============================================================\n\nrectangle \&quot;**Admin Kesehatan**\\n(Pengguna Sistem)\&quot; as admin #EEF2FF\n\n&#39; ============================================================\n&#39;  PROSES 1.0: AUTENTIKASI + DATA STORE\n&#39; ============================================================\n\nusecase \&quot;**1.0**\\nManajemen Autentikasi\\n(Login / Register / 2FA)\&quot; as P1 #DBEAFE\ndatabase \&quot;  **D1** users  \&quot; as D1 #F8FAFC\n\n&#39; ============================================================\n&#39;  PROSES 2.0: KAMAR + DATA STORE\n&#39; ============================================================\n\nusecase \&quot;**2.0**\\nManajemen Data Kamar\\n(Wilayah, Blok, Kapasitas)\&quot; as P2 #D1FAE5\ndatabase \&quot;  **D2** kamars  \&quot; as D2 #F8FAFC\n\n&#39; ============================================================\n&#39;  PROSES 3.0: SANTRI + DATA STORE\n&#39; ============================================================\n\nusecase \&quot;**3.0**\\nManajemen Data Santri\\n(NIS, Nama, Gender)\&quot; as P3 #D1FAE5\ndatabase \&quot;  **D3** santris  \&quot; as D3 #F8FAFC\n\n&#39; ============================================================\n&#39;  PROSES 4.0: GEJALA &amp; PENYAKIT + DATA STORE\n&#39; ============================================================\n\nusecase \&quot;**4.0**\\nManajemen Data\\nGejala &amp; Penyakit\&quot; as P4 #D1FAE5\ndatabase \&quot;  **D4** gejalas  \&quot; as D4 #F8FAFC\ndatabase \&quot;  **D5** penyakits  \&quot; as D5 #F8FAFC\n\n&#39; ============================================================\n&#39;  PROSES 5.0: DATASET TRAINING + DATA STORE\n&#39; ============================================================\n\nusecase \&quot;**5.0**\\nManajemen\\nDataset Training\&quot; as P5 #FFF7ED\ndatabase \&quot;  **D6** dataset_trainings  \\n  + pivot gejala  \&quot; as D6 #F8FAFC\n\n&#39; ============================================================\n&#39;  PROSES 6.0: PREDIKSI NAIVE BAYES\n&#39; ============================================================\n\nusecase \&quot;**6.0**\\nPrediksi &amp; Pengujian\\nModel Naive Bayes\&quot; as P6 #FDE68A\n\n&#39; ============================================================\n&#39;  PROSES 7.0: DASHBOARD EWS + DATA STORE\n&#39; ============================================================\n\nusecase \&quot;**7.0**\\nDashboard EWS\\n&amp; Peta Spasial\&quot; as P7 #FECACA\ndatabase \&quot;  **D7** riwayat_kesehatans  \\n  + pivot gejala  \&quot; as D7 #F8FAFC\ndatabase \&quot;  **D8** ews_alerts  \&quot; as D8 #F8FAFC\n\n&#39; ============================================================\n&#39;  PAKSA URUTAN VERTIKAL (PORTRAIT)\n&#39; ============================================================\n\nadmin -[hidden]down- P1\nP1 -[hidden]down- D1\nD1 -[hidden]down- P2\nP2 -[hidden]down- D2\nD2 -[hidden]down- P3\nP3 -[hidden]down- D3\nD3 -[hidden]down- P4\nP4 -[hidden]down- D4\nD4 -[hidden]right- D5\nD4 -[hidden]down- P5\nP5 -[hidden]down- D6\nD6 -[hidden]down- P6\nP6 -[hidden]down- P7\nP7 -[hidden]down- D7\nD7 -[hidden]right- D8\n\n&#39; ============================================================\n&#39;  ALIRAN DATA\n&#39; ============================================================\n\n&#39; === P1: Autentikasi ===\nadmin -down-&gt; P1 : Email, Password,\\nData Registrasi,\\nKode 2FA\nP1 -up-&gt; admin : Status Login,\\nKonfirmasi Register,\\nAkses Ditolak\nP1 -down-&gt; D1 : Simpan / Update User\nD1 -up-&gt; P1 : Verifikasi Kredensial\n\n&#39; === P2: Kamar ===\nadmin -down-&gt; P2 : Data Kamar\\n(Wilayah, Blok,\\nNama, Kapasitas)\nP2 -up-&gt; admin : Daftar Kamar,\\nKonfirmasi CRUD\nP2 -down-&gt; D2 : Simpan / Update /\\nHapus Kamar\nD2 -up-&gt; P2 : Data Kamar\n\n&#39; === P3: Santri ===\nadmin -down-&gt; P3 : Data Santri\\n(NIS, Nama,\\nGender, Kamar)\nP3 -up-&gt; admin : Daftar Santri,\\nKonfirmasi CRUD\nP3 -down-&gt; D3 : Simpan / Update /\\nHapus Santri\nD3 -up-&gt; P3 : Data Santri\nD2 -down-&gt; P3 : Daftar Kamar\\n(untuk pilihan)\n\n&#39; === P4: Gejala &amp; Penyakit ===\nadmin -down-&gt; P4 : Data Gejala (Kode, Nama)\\nData Penyakit (Kode, Nama,\\nIs Menular, Solusi)\nP4 -up-&gt; admin : Daftar Gejala,\\nDaftar Penyakit,\\nKonfirmasi CRUD\nP4 -down-&gt; D4 : Simpan / Update /\\nHapus Gejala\nD4 -up-&gt; P4 : Data Gejala\nP4 -down-&gt; D5 : Simpan / Update /\\nHapus Penyakit\nD5 -up-&gt; P4 : Data Penyakit\n\n&#39; === P5: Dataset Training ===\nadmin -down-&gt; P5 : Pilihan Penyakit\\n&amp; Pilihan Gejala\\n(kombinasi)\nP5 -up-&gt; admin : Daftar Dataset,\\nKonfirmasi CRUD\nP5 -down-&gt; D6 : Simpan / Update /\\nHapus Dataset\\n+ Sync Pivot Gejala\nD6 -up-&gt; P5 : Data Dataset Training\nD5 -down-&gt; P5 : Daftar Penyakit\\n(opsi pilihan)\nD4 -down-&gt; P5 : Daftar Gejala\\n(opsi checkbox)\n\n&#39; === P6: Prediksi Naive Bayes ===\nadmin -down-&gt; P6 : Perintah\\nJalankan Prediksi\nP6 -up-&gt; admin : Hasil Prediksi\\nper Dataset,\\nAkurasi Model (%),\\nTotal Cocok / Tidak Cocok\nD6 -down-&gt; P6 : Seluruh Dataset\\n+ Relasi Gejala\nD5 -down-&gt; P6 : Semua Penyakit\\n(kelas klasifikasi)\nD4 -down-&gt; P6 : Semua Gejala\\n(fitur / atribut)\n\n&#39; === P7: Dashboard EWS ===\nadmin -down-&gt; P7 : Pilih Kamar\\n(di Peta Spasial),\\nTandai Alert Selesai\nP7 -up-&gt; admin : Statistik Ringkasan,\\nPeta Spasial Kamar,\\nPeringatan Wabah,\\nDetail Santri Sakit\nD2 -down-&gt; P7 : Semua Kamar\\n(Wilayah / Blok)\nD3 -down-&gt; P7 : Jumlah Santri\nD5 -down-&gt; P7 : Info Penyakit\\n(nama, is_menular,\\nsolusi_pencegahan)\nP7 -down-&gt; D7 : -\nD7 -up-&gt; P7 : Riwayat Kesehatan\\n(7 hari terakhir)\nP7 -down-&gt; D8 : Update Status Alert\\n(Aktif → Tertangani)\nD8 -up-&gt; P7 : EWS Alert Aktif\n\n&#39; ============================================================\n&#39;  LEGEND\n&#39; ============================================================\n\nlegend bottom center\n  |= Simbol |= Keterangan |\n  |&lt;#EEF2FF&gt; Kotak | External Entity (Entitas Luar) |\n  |&lt;#DBEAFE&gt; Oval | Proses |\n  |&lt;#F8FAFC&gt; Silinder | Data Store (Penyimpanan Data) |\n  | ──→ | Aliran Data |\n  --\n  **Daftar Proses:**\n  **1.0** Autentikasi  ·  **2.0** Kamar  ·  **3.0** Santri\n  **4.0** Gejala &amp; Penyakit  ·  **5.0** Dataset Training\n  **6.0** Prediksi Naive Bayes  ·  **7.0** Dashboard EWS\nendlegend\n\n@enduml\n&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="VKilzpo9VaYxWsKuG0Ae-386">
          <mxCell parent="1" style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1">
            <mxGeometry height="2153" width="1659" x="3640" y="160" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml EWSCare_DFD_Level_2_Prediksi\n\n&#39; ============================================================\n&#39;  DFD Level 2 — Proses 6.0: Prediksi Naive Bayes\n&#39;  Layout: Portrait / Vertikal Lurus\n&#39; ============================================================\n\ntop to bottom direction\nscale 1\n\nskinparam backgroundColor #FAFAFA\nskinparam shadowing false\nskinparam defaultFontName \&quot;Segoe UI, Inter, Arial\&quot;\nskinparam defaultFontSize 12\nskinparam titleFontSize 20\nskinparam titleFontColor #0F172A\nskinparam titleFontStyle bold\nskinparam ArrowColor #475569\nskinparam RectangleBorderColor #334155\n\ntitle DFD Level 2 — Proses 6.0\\nPrediksi &amp; Pengujian Naive Bayes\n\n&#39; ============================================================\n&#39;  EXTERNAL ENTITY\n&#39; ============================================================\n\nrectangle \&quot;**Admin Kesehatan**\&quot; as admin #EEF2FF\n\n&#39; ============================================================\n&#39;  DATA STORE (sumber data)\n&#39; ============================================================\n\ndatabase \&quot;  **D4** gejalas  \&quot; as D4 #F8FAFC\ndatabase \&quot;  **D5** penyakits  \&quot; as D5 #F8FAFC\ndatabase \&quot;  **D6** dataset_trainings + pivot gejala  \&quot; as D6 #F8FAFC\n\n&#39; ============================================================\n&#39;  SUB-PROSES (urut vertikal lurus)\n&#39; ============================================================\n\nusecase \&quot;**6.1**\\nMuat Seluruh Dataset Training\\n(beserta relasi gejala &amp; penyakit)\&quot; as P61 #FDE68A\n\nusecase \&quot;**6.2**\\nMuat Data Penyakit &amp; Gejala\\n(sebagai kelas &amp; fitur)\&quot; as P62 #FDE68A\n\nusecase \&quot;**6.3**\\nHitung Prior Probability\\nP(Cⱼ) = (n_cj + 1) / (N + K)\&quot; as P63 #FDE68A\n\nusecase \&quot;**6.4**\\nHitung Likelihood per Gejala\\nP(Xᵢ|Cⱼ) dengan Laplace Smoothing\&quot; as P64 #FDE68A\n\nusecase \&quot;**6.5**\\nHitung Posterior Score\\nScore = Prior × Πᵢ Likelihood\&quot; as P65 #FDE68A\n\nusecase \&quot;**6.6**\\nNormalisasi Probabilitas\\nP = score / Σ scores\&quot; as P66 #FDE68A\n\nusecase \&quot;**6.7**\\nKlasifikasi: Pilih Penyakit\\ndengan Probabilitas Tertinggi\&quot; as P67 #FDE68A\n\nusecase \&quot;**6.8**\\nEvaluasi: Bandingkan\\nPrediksi vs Target Dataset\&quot; as P68 #FDE68A\n\nusecase \&quot;**6.9**\\nHitung Akurasi Model\\nAkurasi = (correct / total) × 100%\&quot; as P69 #FDE68A\n\n&#39; ============================================================\n&#39;  OUTPUT\n&#39; ============================================================\n\nrectangle \&quot;**Output ke Admin**\\nHasil Prediksi per Dataset\\nAkurasi Model (%)\\nTotal Cocok / Tidak Cocok\&quot; as output #ECFDF5\n\n&#39; ============================================================\n&#39;  PAKSA URUTAN VERTIKAL LURUS (PORTRAIT)\n&#39; ============================================================\n\nadmin -[hidden]down- D4\nD4 -[hidden]right- D5\nD5 -[hidden]right- D6\n\nD4 -[hidden]down- P61\nP61 -[hidden]down- P62\nP62 -[hidden]down- P63\nP63 -[hidden]down- P64\nP64 -[hidden]down- P65\nP65 -[hidden]down- P66\nP66 -[hidden]down- P67\nP67 -[hidden]down- P68\nP68 -[hidden]down- P69\nP69 -[hidden]down- output\n\n&#39; ============================================================\n&#39;  ALIRAN DATA\n&#39; ============================================================\n\n&#39; --- Admin memicu ---\nadmin -down-&gt; P61 : Perintah\\n\&quot;Perbarui Prediksi\&quot;\n\n&#39; --- Data Store ke Proses ---\nD6 -down-&gt; P61 : Seluruh dataset\\n+ relasi gejala\\n&amp; penyakit\nD5 -down-&gt; P62 : Daftar semua penyakit\\n(C₁, C₂, ..., Cₙ)\nD4 -down-&gt; P62 : Daftar semua gejala\\n(X₁, X₂, ..., Xₘ)\n\n&#39; --- Alur proses vertikal ---\nP61 -down-&gt; P63 : Dataset per item:\\ngejala yang dimiliki,\\npenyakit target\n\nP62 -down-&gt; P63 : Total dataset,\\njumlah penyakit\n\nP63 -down-&gt; P64 : Prior P(Cⱼ)\\nuntuk setiap penyakit\n\nP62 -down-&gt; P64 : Daftar gejala\\nsebagai fitur\n\nP64 -down-&gt; P65 : Likelihood\\nper penyakit\n\nP63 -down-&gt; P65 : Prior\\nper penyakit\n\nP65 -down-&gt; P66 : Score mentah\\nper penyakit\n\nP66 -down-&gt; P67 : Probabilitas\\nternormalisasi\n\nP67 -down-&gt; P68 : Penyakit prediksi\\n+ probabilitas\n\nP61 -down-&gt; P68 : Penyakit target\\n(ground truth)\n\nP68 -down-&gt; P69 : Status Cocok /\\nTidak Cocok\\nper dataset\n\n&#39; --- Output ---\nP67 -down-&gt; output : Tabel Hasil\\nPrediksi\n\nP69 -down-&gt; output : Akurasi Model,\\nTotal Cocok,\\nTotal Tidak Cocok\n\noutput -down-&gt; admin : Tampilkan ke\\nAdmin Kesehatan\n\n&#39; ============================================================\n&#39;  LEGEND\n&#39; ============================================================\n\nlegend bottom center\n  |= Sub-Proses |= Keterangan |\n  | **6.1** | Muat seluruh dataset training + relasi |\n  | **6.2** | Muat daftar penyakit (kelas) &amp; gejala (fitur) |\n  | **6.3** | Hitung Prior Probability dengan Laplace Smoothing |\n  | **6.4** | Hitung Likelihood tiap gejala terhadap penyakit |\n  | **6.5** | Hitung Posterior = Prior × Πᵢ Likelihood |\n  | **6.6** | Normalisasi: probability = score / Σ scores |\n  | **6.7** | Klasifikasi: pilih penyakit dengan P tertinggi |\n  | **6.8** | Evaluasi: bandingkan prediksi vs target asli |\n  | **6.9** | Hitung akurasi = (correct / total) × 100% |\nendlegend\n\n@enduml\n&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="VKilzpo9VaYxWsKuG0Ae-387">
          <mxCell parent="1" style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1">
            <mxGeometry height="1870" width="709" x="5830" y="110" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nleft to right direction\nactor \&quot;Admin / Pengurus Kesehatan\&quot; as Admin\n\nrectangle \&quot;Sistem EWS Care\&quot; {\n    usecase \&quot;Autentikasi (Login &amp; 2FA)\&quot; as UC_Auth\n    usecase \&quot;Kelola Data Kamar\&quot; as UC_Kamar\n    usecase \&quot;Kelola Data Santri\&quot; as UC_Santri\n    usecase \&quot;Kelola Data Gejala\&quot; as UC_Gejala\n    usecase \&quot;Kelola Data Penyakit\&quot; as UC_Penyakit\n    usecase \&quot;Kelola Dataset Training\&quot; as UC_Dataset\n    usecase \&quot;Uji &amp; Evaluasi Prediksi Naive Bayes\&quot; as UC_Prediksi\n    usecase \&quot;Pantau Dashboard Spasial EWS\&quot; as UC_Dashboard\n    usecase \&quot;Tangani Peringatan Wabah (Alert)\&quot; as UC_Alert\n    usecase \&quot;Lihat Laporan Riwayat Kesehatan\&quot; as UC_Laporan\n}\n\nAdmin --&gt; UC_Auth\nAdmin --&gt; UC_Kamar\nAdmin --&gt; UC_Santri\nAdmin --&gt; UC_Gejala\nAdmin --&gt; UC_Penyakit\nAdmin --&gt; UC_Dataset\nAdmin --&gt; UC_Prediksi\nAdmin --&gt; UC_Dashboard\nAdmin --&gt; UC_Alert\nAdmin --&gt; UC_Laporan\n@endum\n&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="zTA6TgrVGysnWl21C-zQ-1">
          <mxCell parent="1" style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1">
            <mxGeometry height="818" width="532" x="50" y="3060" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\nstart\n:Admin membuka Dashboard EWS;\n:Sistem mengambil data riwayat kasus kesehatan (7 hari terakhir);\n:Sistem mengelompokkan kamar berdasarkan Wilayah dan Blok;\n:Sistem mengecek status penyebaran penyakit di tiap kamar;\n\nsplit\n  :Kamar dengan 0 kasus (Aman);\n  :Beri warna hijau pada kamar;\nsplit again\n  :Ada kasus biasa (Siaga);\n  :Beri warna kuning pada kamar;\nsplit again\n  :Ada kasus menular (Bahaya / Outbreak);\n  :Beri warna merah pada kamar (berkedip);\n  :Sistem memicu EWS Alert &amp; menampilkan solusi tindakan;\nend split\n\n:Sistem menampilkan Peta Spasial dan Alert Banner;\n\nif (Admin memilih kamar tertentu?) then (Ya)\n  :Tampilkan detail santri sakit beserta gejalanya;\nendif\n\nif (Admin menandai alert wabah selesai?) then (Ya)\n  :Ubah status EwsAlert menjadi \&quot;Tertangani\&quot;;\n  :Perbarui status peta spasial;\nendif\n\nstop\n@endum\n&quot;,&quot;format&quot;:&quot;svg&quot;}" id="zTA6TgrVGysnWl21C-zQ-2">
          <mxCell parent="1" style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1">
            <mxGeometry height="933" width="786" x="730" y="2980" as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nclass User {\n    + id: bigIncrements\n    + name: string\n    + email: string\n    + password: string\n    + two_factor_secret: string\n    + two_factor_confirmed_at: timestamp\n}\n\nclass Kamar {\n    + id: bigIncrements\n    + wilayah: string\n    + blok: string\n    + nama_kamar: string\n    + kapasitas: integer\n    + santris()\n    + riwayatKesehatans()\n    + ewsAlerts()\n}\n\nclass Santri {\n    + id: bigIncrements\n    + kamar_id: foreignId\n    + nis: string\n    + nama: string\n    + gender: enum(&#39;L&#39;, &#39;P&#39;)\n    + kamar()\n}\n\nclass Gejala {\n    + id: bigIncrements\n    + kode_gejala: string\n    + nama_gejala: string\n}\n\nclass Penyakit {\n    + id: bigIncrements\n    + kode_penyakit: string\n    + nama_penyakit: string\n    + is_menular: boolean\n    + solusi_pencegahan: text\n}\n\nclass DatasetTraining {\n    + id: bigIncrements\n    + penyakit_id: foreignId\n    + penyakit()\n    + gejalas()\n}\n\nclass RiwayatKesehatan {\n    + id: bigIncrements\n    + santri_id: foreignId\n    + penyakit_id: foreignId\n    + kamar_id: foreignId\n    + tanggal_periksa: date\n    + probabilitas: double\n    + tingkat_keyakinan: double\n    + santri()\n    + penyakit()\n    + kamar()\n    + gejalas()\n}\n\nclass EwsAlert {\n    + id: bigIncrements\n    + kamar_id: foreignId\n    + wilayah: string\n    + blok: string\n    + penyakit_id: foreignId\n    + jumlah_kasus: integer\n    + status: enum(&#39;Aktif&#39;, &#39;Tertangani&#39;)\n    + tanggal_dideteksi: date\n    + kamar()\n    + penyakit()\n}\n\nKamar \&quot;1\&quot; *-- \&quot;0..*\&quot; Santri : menampung &gt;\nSantri \&quot;1\&quot; *-- \&quot;0..*\&quot; RiwayatKesehatan : memiliki &gt;\nKamar \&quot;1\&quot; *-- \&quot;0..*\&quot; RiwayatKesehatan : mencatat lokasi &gt;\nPenyakit \&quot;1\&quot; *-- \&quot;0..*\&quot; RiwayatKesehatan : didiagnosis &gt;\nRiwayatKesehatan \&quot;0..*\&quot; *--* \&quot;0..*\&quot; Gejala : dialami &gt;\n\nPenyakit \&quot;1\&quot; *-- \&quot;0..*\&quot; DatasetTraining : melatih &gt;\nDatasetTraining \&quot;0..*\&quot; *--* \&quot;0..*\&quot; Gejala : memuat &gt;\n\nKamar \&quot;1\&quot; *-- \&quot;0..*\&quot; EwsAlert : terjadi di &gt;\nPenyakit \&quot;1\&quot; *-- \&quot;0..*\&quot; EwsAlert : mendeteksi &gt;\n@endum\n&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="zTA6TgrVGysnWl21C-zQ-3">
          <mxCell parent="1" style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1">
            <mxGeometry height="850" width="936" x="1710" y="3010" as="geometry" />
          </mxCell>
        </UserObject>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
